# Server-only configuration. Never commit a populated .env.
DATABASE_URL=postgresql://agent:SET_PASSWORD@127.0.0.1:5432/team11
# Used by explicit provisioning CLI, not by the agent runtime:
DATABASE_POLICY_URL=postgresql://publisher:SET_PASSWORD@127.0.0.1:5432/team11
AUTH_TOKEN_HASHES={}
SERVICE_ROLE=agent
HOST=127.0.0.1
PORT=4174
POLICY_BUNDLE_ROOT=policies
PYTHON_BIN=python
KILN_API_KEY=
KILN_MODEL=qwen3-32b
SEARCH_AGENT_MODE=local
KILN_CONCURRENCY=4
KILN_RPM=50
REQUIRE_PROVIDER_HIT=false
SEARCH_API_URL=http://127.0.0.1:4479
SOURCE_ALLOWED_HOSTS=
# Optional search API. Only used when configured; Kiln remains the Qwen model provider.
TAVILY_API_KEY=
# Only set these in the isolated audit worker process:
TRACK_RPC_URL=
TRACK_VERIFY_RPC_URL=
WALLET_MASTER_KEY=
AUDIT_GAS_MODE=personal
# For relayer mode only. Never expose this to Vercel or the agent process.
AUDIT_RELAYER_PRIVATE_KEY=
