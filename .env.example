# Server-only configuration. Never commit a populated .env.
DATABASE_URL=postgresql://agent:SET_PASSWORD@127.0.0.1:5432/team11
# Used by explicit provisioning CLI, not by the agent runtime:
DATABASE_POLICY_URL=postgresql://publisher:SET_PASSWORD@127.0.0.1:5432/team11
AUTH_TOKEN_HASHES={}
SERVICE_ROLE=agent
HOST=127.0.0.1
PORT=4174
POLICY_BUNDLE_ROOT=policies
PYTHON_BIN=python
KILN_API_KEY=
KILN_MODEL=qwen3-32b
KILN_CONCURRENCY=4
KILN_RPM=50
REQUIRE_PROVIDER_HIT=false
BRAVE_SEARCH_API_KEY=
SOURCE_ALLOWED_HOSTS=
# Only set these in the isolated audit worker process:
TRACK_RPC_URL=
TRACK_VERIFY_RPC_URL=
TRACK_CHAIN_PRIVATE_KEY=
