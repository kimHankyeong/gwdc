{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --workspace @team11/frontend --include-workspace-root=false",
  "buildCommand": "npm run build -w @team11/frontend",
  "outputDirectory": "frontend/dist",
  "functions": { "api/gateway.mjs": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/gateway?path=:path*" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Frame-Options", "value": "DENY" }
  ] }]
}
